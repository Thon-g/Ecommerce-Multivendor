# === Database ===
DB_URL=jdbc:mysql://localhost:3306/ecommerce-db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password

# === Server ===
SERVER_PORT=8080

# === JWT ===
security.jwt.secret=your_jwt_secret_at_least_32_bytes_long
security.jwt.reset-secret=your_reset_secret_at_least_32_bytes_long
security.jwt.expiration=3600000
security.jwt.refresh-expiration=86400000
security.jwt.reset-expiration=900000

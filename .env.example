# === Database ===
DB_URL=jdbc:mysql://localhost:3307/ecommerce-db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_password

# === Server ===
SERVER_PORT=8080

# === JWT ===
security.jwt.secret=your_jwt_secret_at_least_32_bytes_long
security.jwt.reset-secret=your_reset_secret_at_least_32_bytes_long
security.jwt.expiration=3600000
security.jwt.refresh-expiration=86400000
security.jwt.reset-expiration=900000

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Mail ===
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# === AI Providers (gemini | ollama) ===
AI_CHAT_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=ollama

# === Gemini ===
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# === Ollama (Local) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Vector Store ===
CHROMA_HOST=http://localhost
CHROMA_PORT=8000

